@model List<lison3.Models.Book>

@{
    ViewData["Title"] = "Danh sách sách";
}

<div class="container mt-4">
    <h2>📚 Danh sách sách</h2>
    <a asp-action="Create" class="btn btn-success mb-3">+ Thêm sách mới</a>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Tên sách</th>
                <th>Giá ($)</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Id</td>
                    <td>@book.Name</td>
                    <td>@book.Price</td>
                    <td>
                        <a asp-action="Detail" asp-route-id="@book.Id" class="btn btn-info btn-sm">Xem chi tiết</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>