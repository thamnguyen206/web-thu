@model IEnumerable<YourProjectName.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";

    DayOfWeek today = DateTime.Now.DayOfWeek;
    bool isWeekend = (today == DayOfWeek.Saturday || today == DayOfWeek.Sunday);
}

<div class="container mt-4">

    @if (isWeekend)
    {
        <div class="alert alert-success" role="alert">
            🎉 <strong>Hôm nay là cuối tuần!</strong> Chúc bạn mua sắm vui vẻ.
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            💼 <strong>Hôm nay là ngày trong tuần (Thứ @((int)today + 1)).</strong> Chúc bạn một ngày làm việc hiệu quả!
        </div>
    }

    
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Danh sách sản phẩm</h2>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addProductModal">
            + Thêm sản phẩm mới
        </button>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Mã SP (ID)</th>
                <th>Tên sản phẩm</th>
                <th>Giá bán</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Id</td>
                        <td>@product.Name</td>
                        <td>@product.Price.ToString("N0") VNĐ</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center">Không có sản phẩm nào trong CSDL.</td>
                </tr>
            }
        </tbody>
    </table>
</div>


<div class="modal fade" id="addProductModal" tabindex="-1" aria-labelledby="addProductModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addProductModalLabel">Thêm sản phẩm mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tên sản phẩm</label>
                        <input type="text" name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Giá bán (VNĐ)</label>
                        <input type="number" name="Price" class="form-control" step="1000" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success">Lưu sản phẩm</button>
                </div>
            </form>
        </div>
    </div>
</div>